# Copy to ~/.config/kalshi-multiplex-orderbook/prod.env
# chmod 600 ~/.config/kalshi-multiplex-orderbook/prod.env
#
# Preferred names (prod):
KALSHI_PROD_API_KEY_ID=your-prod-api-key-id
KALSHI_PROD_PRIVATE_KEY_FILE=prod.private-key.pem
#
# Relative private-key paths resolve under ~/.config/kalshi-multiplex-orderbook/
# Absolute paths are also fine.
#
# Legacy names still accepted:
# KALSHI_API_KEY_ID=...
# KALSHI_PRIVATE_KEY_FILE=/absolute/path/to/key.pem
